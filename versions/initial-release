            end
        end
        if violentGroup(words) then
            signal("hate", "violent_group_targeting")
        end
        if not targeted then
            for index, word in ipairs(words) do
                if Profanity[word] and not negated(words, index) then
                    signal("profanity", "explicit_profanity")
                    break
                end
            end
        end
    end
    if result.needsSupport and (not result.corroborated or result.category == "profanity") then
        result.category = "self_harm"
        result.confidence = 0.90 + 0.09 * (scores.self_harm or 0)
        result.risk = 0
        result.corroborated = false
        result.support = true
        result.evidence = {"support_request"}
    elseif result.corroborated then
        local matching = scores[Aliases[result.category] or result.category] or 0
        result.confidence = 0.80 + 0.18 * matching
        result.risk = chosenWeight * (0.90 + 0.10 * matching)
        result.obfuscated = changed
        if changed and #result.evidence < 6 then
            result.evidence[#result.evidence + 1] = "normalized_evasion"
        end
    elseif contextual then
        result.category = "benign"
        result.confidence = math.max(scores.benign or 0, 0.75)
        result.evidence = {"contextual_language"}
    elseif neuralCategory ~= "benign" and neuralCategory ~= "self_harm" and neuralConfidence >= 0.60 then
        result.category = neuralCategory
        result.confidence = neuralConfidence
        result.risk = 0.18 * neuralConfidence
        result.evidence = {"model_signal"}
    end
    return result
end

return {
    analyze=analyze,
    version="Starlight Local 2.0.0",
    info={architecture="256 hashed features / 16 ReLU units / 8 outputs",parameters=4248,trainingExamples=309,validationExamples=60,validationAccuracy=0.85,language="English",maxBytes=2048,maxCharacters=500,maxTokens=96,calibrated=false,onlineTraining=false},
}

end)()

local Runtime = (function()
	local Players = game:GetService("Players")
	local TextChatService = game:GetService("TextChatService")
	local DataStoreService = game:GetService("DataStoreService")
	local RunService = game:GetService("RunService")
	local HttpService = game:GetService("HttpService")
	assert(RunService:IsServer(), "Starlight Neural must run in ServerScriptService")

	local states, pending, audit, connections = {}, {}, {}, {}
	local metrics = {messages = 0, analyses = 0, cached = 0, blocked = 0, errors = 0, saves = 0, saveFailures = 0, persistenceDropped = 0, overload = 0, totalAnalysisTime = 0, maxAnalysisTime = 0}
	local active, closing, workers, pendingCount = true, false, 0, 0
	local nextSave, windowStart, windowCount, windowCost = os.clock() + CONFIG.PersistenceInterval, os.clock(), 0, 0
	local draining = false
	local store, lastErrorAt = nil, -math.huge
	local sessionId = HttpService:GenerateGUID(false)
	local changeSequence = 0
	local bound = setmetatable({}, {__mode = "k"})
	local api = {}

	local function finite(value, fallback, minimum, maximum)
		if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
			return fallback
		end
		return math.clamp(value, minimum, maximum)
	end

	local function issue(message)
		metrics.errors += 1
		if os.clock() - lastErrorAt >= 30 then
			lastErrorAt = os.clock()
			warn("[Starlight Neural] " .. message)
		end
	end

	local function newCache(capacity, ttl)
		return {map = {}, ring = table.create(capacity), next = 1, size = 0, capacity = capacity, ttl = ttl}
	end

	local cache = newCache(CONFIG.CacheLimit, CONFIG.CacheTTL)
	local semanticCache = newCache(CONFIG.SemanticCacheLimit, CONFIG.SemanticCacheTTL)

	local function cacheGet(target, key, now)
		local entry = target.map[key]
		if entry and entry.expires > now then
			return entry.value
		end
		return nil
	end

	local function cachePut(target, key, value, now)
		local old = target.ring[target.next]
		if old and target.map[old.key] == old then
			target.map[old.key] = nil
			target.size -= 1
		end
		local entry = {key = key, value = value, expires = now + target.ttl}
		if not target.map[key] then target.size += 1 end
		target.map[key] = entry
		target.ring[target.next] = entry
		target.next = target.next % target.capacity + 1
	end

	local function pruneCache(target, now)
		for index, entry in target.ring do
			if entry.expires <= now then
				if target.map[entry.key] == entry then
					target.map[entry.key] = nil
					target.size -= 1
				end
				target.ring[index] = nil
			end
		end
	end

	local function push(list, value, limit)
		if #list >= limit then table.remove(list, 1) end
		list[#list + 1] = value
	end

	local function isAdmin(player)
		for _, id in CONFIG.AdminUserIds do
			if player.UserId == id then return true end
		end
		for _, name in CONFIG.AdminAttributes do
			if player:GetAttribute(name) == true then return true end
		end
		return false
	end

	local function event(name)
		local item = script:FindFirstChild(name)
		if item then
			assert(item:IsA("BindableEvent"), name .. " must be a BindableEvent")
			return item
		end
		item = Instance.new("BindableEvent")
		item.Name = name
		item.Parent = script
		return item
	end

	local moderationEvent = event("ModerationEvent")
	local reviewEvent = event("ReviewEvent")

	local function notifyPlayer(state, kind)
		if not CONFIG.NotificationsEnabled or not state.player or os.clock() - state.lastNotice < CONFIG.NotificationCooldown then return end
		state.lastNotice = os.clock()
		local player = state.player
		task.defer(function()
			if not active or states[player.UserId] ~= state then return end
			local gui = player:FindFirstChildOfClass("PlayerGui")
			if not gui then return end
			local old = gui:FindFirstChild("StarlightNotice")
			if old then old:Destroy() end
			local screen = Instance.new("ScreenGui")
			screen.Name = "StarlightNotice"
			screen.ResetOnSpawn = false
			screen.DisplayOrder = 100
			local label = Instance.new("TextLabel")
			label.AnchorPoint = Vector2.new(0.5, 0)
			label.Position = UDim2.fromScale(0.5, 0.08)
			label.Size = UDim2.new(0.8, 0, 0, 110)
			label.BackgroundColor3 = Color3.fromRGB(24, 28, 38)
			label.BackgroundTransparency = 0.06
			label.TextColor3 = Color3.fromRGB(245, 247, 255)
			label.TextSize = 18
			label.Font = Enum.Font.GothamMedium
			label.TextWrapped = true
			label.RichText = false
			label.BorderSizePixel = 0
			label.Text = kind == "Support"
				and "You deserve support. If you might hurt yourself, contact emergency services or a trusted person nearby now."
				or (kind == "Mute" or kind == "LongMute")
				and "Chat is temporarily paused after repeated policy violations. Please keep the conversation respectful and safe."
				or "That message was held back. Please avoid threats, personal attacks, unsafe requests, and scams."
			label.Parent = screen
			screen.Parent = gui
			task.delay(12, function() screen:Destroy() end)
		end)
	end

	local function decay(value, elapsed)
		return value * 2 ^ (-math.max(0, elapsed) / CONFIG.RiskHalfLife)
	end

	local function touchRisk(state, now)
		state.risk = decay(state.risk, now - state.riskAt)
		state.riskAt = now
	end

	local function snapshot(state)
		touchRisk(state, os.clock())
		return {
			schema = 2,
			warningCount = state.warningCount,
			risk = state.risk,
			riskUpdatedAt = os.time(),
			muteUntil = state.muteUntil,
			muteChangedAt = state.muteChangedAt,
			muteChangeId = state.muteChangeId,
			updatedAt = os.time(),
		}
	end

	local function sanitize(data)
		data = type(data) == "table" and data or {}
		return {
			schema = 2,
			warningCount = math.floor(finite(data.warningCount, 0, 0, 1000000)),
			risk = finite(data.risk or data.rollingRisk, 0, 0, 1),
			riskUpdatedAt = finite(data.riskUpdatedAt, os.time(), 0, os.time() + 60),
			muteUntil = finite(data.muteUntil or data.muteExpirationUnix, 0, 0, os.time() + 86400),
			muteChangedAt = finite(data.muteChangedAt, data.muteExpirationUnix and 1 or 0, 0, os.time() + 60),
			muteChangeId = type(data.muteChangeId) == "string" and data.muteChangeId:sub(1, 128) or "",
			updatedAt = finite(data.updatedAt, 0, 0, os.time() + 60),
		}
	end

	local function newerMute(left, right)
		return left.muteChangedAt > right.muteChangedAt
			or (left.muteChangedAt == right.muteChangedAt and left.muteChangeId > right.muteChangeId)
	end

	local function merge(left, right)
		left, right = sanitize(left), sanitize(right)
		local now = os.time()
		local chosen = newerMute(right, left) and right or left
		return {
			schema = 2,
			warningCount = math.max(left.warningCount, right.warningCount),
			risk = math.max(decay(left.risk, now - left.riskUpdatedAt), decay(right.risk, now - right.riskUpdatedAt)),
			riskUpdatedAt = now,
			muteUntil = chosen.muteUntil,
			muteChangedAt = chosen.muteChangedAt,
			muteChangeId = chosen.muteChangeId,
			updatedAt = now,
		}
	end

	local function enqueue(state)
		if not CONFIG.PersistenceEnabled or state.userId <= 0 then return end
		local item = pending[state.userId]
		if not item then
			if pendingCount >= CONFIG.PersistenceMaxPending then
				state.dirty = true
				issue("Persistence backlog is full; unsaved player state will be retried.")
				return
			end
			item = {data = snapshot(state), revision = 0, attempts = 0, nextAttempt = 0, inFlight = false}
			pending[state.userId] = item
			pendingCount += 1
		else
			item.data = merge(item.data, snapshot(state))
		end
		item.revision += 1
		state.dirty = false
	end

	local function getStore()
		if not store then store = DataStoreService:GetDataStore(CONFIG.PersistenceStore) end
		return store
	end

	local function hasBudget(kind)
		local ok, budget = pcall(function()
			return DataStoreService:GetRequestBudgetForRequestType(kind)
		end)
		return ok and budget >= 1
	end

	local function saveOne(userId, item)
		local revision, data = item.revision, item.data
		item.inFlight = true
		workers += 1
		task.spawn(function()
			local ok, saved = pcall(function()
				return getStore():UpdateAsync(tostring(userId), function(previous)
					return merge(previous, data)
				end)
			end)
			workers -= 1
			item.inFlight = false
			if ok then
				metrics.saves += 1
				if pending[userId] == item and item.revision == revision then
					pending[userId] = nil
					pendingCount -= 1
				end
				local state = states[userId]
				if state and type(saved) == "table" then
					local safe = sanitize(saved)
					state.warningCount = math.max(state.warningCount, safe.warningCount)
					state.player:SetAttribute("StarlightWarnings", state.warningCount)
					if newerMute(safe, state) then
						state.muteUntil, state.muteChangedAt, state.muteChangeId = safe.muteUntil, safe.muteChangedAt, safe.muteChangeId
						state.player:SetAttribute("StarlightMutedUntil", state.muteUntil)
					end
				end
			else
				metrics.saveFailures += 1
				item.attempts += 1
				item.nextAttempt = os.clock() + math.min(CONFIG.PersistenceMaxRetry, CONFIG.PersistenceRetryBase * 2 ^ math.min(item.attempts - 1, 10))
				issue("DataStore save failed; the latest state remains queued.")
			end
		end)
	end

	local function flush()
		if not CONFIG.PersistenceEnabled then return end
		draining = pendingCount > 0
		for userId, item in pending do
			if workers >= CONFIG.PersistenceConcurrency then break end
			if not item.inFlight and item.nextAttempt <= os.clock() then
				if not hasBudget(Enum.DataStoreRequestType.UpdateAsync) then break end
				saveOne(userId, item)
			end
		end
	end

	local function loadState(state)
		if not CONFIG.PersistenceEnabled or state.userId <= 0 or state.loading or state.loaded then return end
		if not hasBudget(Enum.DataStoreRequestType.GetAsync) then return end
		state.loading = true
		task.spawn(function()
			local ok, data = pcall(function() return getStore():GetAsync(tostring(state.userId)) end)
			if states[state.userId] ~= state then return end
			state.loading = false
			if not ok then
				state.loadAttempts += 1
				state.nextLoad = os.clock() + math.min(CONFIG.PersistenceMaxRetry, CONFIG.PersistenceRetryBase * 2 ^ math.min(state.loadAttempts - 1, 10))
				issue("DataStore load failed; continuing local moderation and retrying.")
				return
			end
			state.loaded = true
			local saved = sanitize(data)
			touchRisk(state, os.clock())
			state.risk = math.max(state.risk, decay(saved.risk, os.time() - saved.riskUpdatedAt))
			state.warningCount = math.max(state.warningCount, saved.warningCount)
			state.player:SetAttribute("StarlightWarnings", state.warningCount)
			if newerMute(saved, state) then
				state.muteUntil, state.muteChangedAt, state.muteChangeId = saved.muteUntil, saved.muteChangedAt, saved.muteChangeId
				state.player:SetAttribute("StarlightMutedUntil", state.muteUntil)
			end
		end)
	end

	local function addPlayer(player)
		if states[player.UserId] then return states[player.UserId] end
		local now = os.clock()
		local state = {
			userId = player.UserId, player = player, risk = 0, riskAt = now,
			warningCount = 0, muteUntil = 0, muteChangedAt = 0, muteChangeId = "",
			tokens = CONFIG.RateLimitBurst, rateAt = now,
			lastWarning = -math.huge, lastNotice = -math.huge, lastCommand = -math.huge,
			history = {}, strikes = {}, seriousStrikes = {}, loaded = false, loading = false,
			loadAttempts = 0, nextLoad = 0, dirty = false,
		}
		states[player.UserId] = state
		if pending[player.UserId] then
			local saved = sanitize(pending[player.UserId].data)
			state.warningCount, state.risk = saved.warningCount, saved.risk
			state.muteUntil, state.muteChangedAt, state.muteChangeId = saved.muteUntil, saved.muteChangedAt, saved.muteChangeId
		end
		player:SetAttribute("StarlightMutedUntil", state.muteUntil)
		player:SetAttribute("StarlightWarnings", state.warningCount)
		loadState(state)
		return state
	end

	local function setMute(state, duration)
		changeSequence += 1
		state.muteUntil = duration > 0 and os.time() + duration or 0
		state.muteChangedAt = math.max(DateTime.now().UnixTimestampMillis / 1000, state.muteChangedAt + 0.000001)
		state.muteChangeId = sessionId .. ":" .. tostring(changeSequence)
		state.player:SetAttribute("StarlightMutedUntil", state.muteUntil)
		state.dirty = true
		enqueue(state)
	end

	local function removePlayer(player)
		local state = states[player.UserId]
		if not state or state.player ~= player then return end
		touchRisk(state, os.clock())
		if state.dirty then enqueue(state) end
		if state.dirty and CONFIG.PersistenceEnabled then
			metrics.persistenceDropped += 1
			warn("[Starlight Neural] Persistence capacity exhausted; departing user " .. tostring(state.userId) .. " could not be saved.")
			reviewEvent:Fire({timestamp = os.time(), userId = state.userId, action = "PersistenceFailure"})
		end
		states[player.UserId] = nil
		flush()
	end

	local function auditDecision(state, messageId, decision)
		local result = decision.result
		local entry = {
			timestamp = os.time(), userId = state.userId, messageId = tostring(messageId or ""):sub(1, 128),
			category = result and result.category or "unknown", confidence = result and result.confidence or 0,
			risk = result and result.risk or 0, action = decision.action,
			needsSupport = result ~= nil and (result.support == true or result.needsSupport == true),
			evidence = result and table.clone(result.evidence) or {}, modelVersion = Engine.version,
		}
		push(audit, entry, CONFIG.AuditRetention)
		if decision.action ~= "Allow" and decision.action ~= "Observe" then
			local emitted = table.clone(entry)
			emitted.evidence = table.clone(entry.evidence)
			task.defer(function()
				if not active then return end
				moderationEvent:Fire(emitted)
				if decision.action == "Support" or (result and (result.needsSupport or (result.corroborated and result.risk >= 0.85))) then
					reviewEvent:Fire(table.clone(emitted))
				end
			end)
		end
		if CONFIG.Debug then
			print(string.format("[Starlight Neural] %d | %s | %.3f | %s", state.userId, entry.category, entry.risk, entry.action))
		end
	end

	local function consumeRate(state, now)
		state.tokens = math.min(CONFIG.RateLimitBurst, state.tokens + math.max(0, now - state.rateAt) * CONFIG.RateLimitPerSecond)
		state.rateAt = now
		if state.tokens < 1 then return false end
		state.tokens -= 1
		return true
	end

	local function classify(text, now)
		local result = cacheGet(semanticCache, text, now)
		if result then return result end
		if now - windowStart >= CONFIG.AnalysisWindow then
			windowStart, windowCount, windowCost = now, 0, 0
		end
		if windowCount >= CONFIG.MaxAnalysesPerWindow or windowCost >= CONFIG.AnalysisBudgetSeconds then
			metrics.overload += 1
			return nil, "Busy"
		end
		windowCount += 1
		local started = os.clock()
		local ok, value = pcall(Engine.analyze, text)
		local elapsed = os.clock() - started
		windowCost += elapsed
		metrics.analyses += 1
		metrics.totalAnalysisTime += elapsed
		metrics.maxAnalysisTime = math.max(metrics.maxAnalysisTime, elapsed)
		if not ok or type(value) ~= "table" then
			issue("Message analysis failed; message held for this delivery.")
			return nil, "Unavailable"
		end
		cachePut(semanticCache, text, value, now)
		return value
	end

	local function decide(state, result, now)
		if result.invalid or result.truncated then return {deliver = false, action = "Invalid", result = result} end
		if result.needsSupport then notifyPlayer(state, "Support") end
		if result.support then
			notifyPlayer(state, "Support")
			return {deliver = true, action = "Support", result = result}
		end
		touchRisk(state, now)
		local repeats, related = 0, 0
		for _, previous in state.history do
			if now - previous.time <= 12 and previous.normalized == result.normalized then repeats += 1 end
			if now - previous.time <= CONFIG.ContextLifetime and previous.corroborated and previous.category == result.category then related += 1 end
		end
		push(state.history, {time = now, normalized = result.normalized, category = result.category, corroborated = result.corroborated}, CONFIG.HistoryLength)
		if repeats >= 3 and #result.normalized >= 3 then
			return {deliver = false, action = "RateLimit", result = result}
		end
		local repeatedConcern = related >= 2 and result.risk >= 0.38
		local violation = result.corroborated and (result.risk >= CONFIG.BlockRisk or repeatedConcern) and result.confidence >= CONFIG.BlockConfidence
		if not violation then return {deliver = true, action = result.risk >= 0.3 and "Observe" or "Allow", result = result} end
		while state.strikes[1] and now - state.strikes[1] > CONFIG.StrikeWindow do table.remove(state.strikes, 1) end
		push(state.strikes, now, 20)
		while state.seriousStrikes[1] and now - state.seriousStrikes[1] > CONFIG.KickStrikeWindow do table.remove(state.seriousStrikes, 1) end
		if result.risk >= 0.85 then push(state.seriousStrikes, now, 30) end
		state.risk = math.max(state.risk, result.risk)
		state.dirty = true
		local action = "SoftSuppress"
		if #state.strikes >= CONFIG.LongMuteAfterStrikes then
			action = "LongMute"
			setMute(state, CONFIG.LongMuteDuration)
		elseif #state.strikes >= CONFIG.MuteAfterStrikes then
			action = "Mute"
			setMute(state, CONFIG.MuteDuration)
		elseif now - state.lastWarning >= CONFIG.WarningCooldown then
			action = "Warn"
			state.lastWarning = now
			state.warningCount += 1
			state.player:SetAttribute("StarlightWarnings", state.warningCount)
		end
		if CONFIG.AutomaticKick and #state.seriousStrikes >= CONFIG.KickAfterStrikes and result.risk >= 0.9 and result.confidence >= 0.95 then
			action = "Kick"
			local player = state.player
			task.defer(function()
				if active and states[state.userId] == state then player:Kick("Removed for repeated chat policy violations.") end
			end)
		end
		state.player:SetAttribute("StarlightLastAction", action)
		enqueue(state)
		notifyPlayer(state, action)
		return {deliver = false, action = action, result = result}
	end

	local function process(player, message)
		if not CONFIG.Enabled or not active then return {deliver = true, action = "Allow"} end
		if CONFIG.AdminBypass and isAdmin(player) then return {deliver = true, action = "Allow"} end
		local now = os.clock()
		local id = message.MessageId
		local key = type(id) == "string" and #id > 0 and #id <= 128 and tostring(player.UserId) .. ":" .. id or message
		local existing = cacheGet(cache, key, now)
		if existing then metrics.cached += 1; return existing end
		local state = states[player.UserId] or addPlayer(player)
		local decision
		local text = message.Text
		metrics.messages += 1
		if state.muteUntil > os.time() then
			decision = {deliver = false, action = "Muted"}
		elseif type(text) ~= "string" or #text > CONFIG.MaxMessageBytes then
			decision = {deliver = false, action = "Invalid"}
		elseif text == "" then
			decision = {deliver = true, action = "Allow"}
		elseif not consumeRate(state, now) then
			decision = {deliver = false, action = "RateLimit"}
		else
			local result, reason = classify(text, now)
			decision = result and decide(state, result, now) or {deliver = false, action = reason}
		end
		cachePut(cache, key, decision, now)
		if not decision.deliver then metrics.blocked += 1 end
		if decision.result then auditDecision(state, id, decision) end
		return decision
	end

	local function bindChannel(channel)
		if bound[channel] or not channel:IsA("TextChannel") then return end
		if CONFIG.ChannelFilter and not CONFIG.ChannelFilter(channel) then return end
		if channel:GetAttribute("StarlightNeuralBound") then
			issue("A channel already has Starlight Neural installed; duplicate binding skipped.")
			return
		end
		local callback = function(message, recipient)
			if CONFIG.DeliveryFilter then
				local allowed, value = pcall(CONFIG.DeliveryFilter, channel, message, recipient)
				if not allowed then issue("DeliveryFilter failed."); return false end
				if not value then return false end
			end
			if not message.TextSource then return true end
			local player = Players:GetPlayerByUserId(message.TextSource.UserId)
			if not player then return false end
			local ok, decision = pcall(process, player, message)
			if not ok then issue("Chat callback failed; message held for this delivery."); return false end
			return decision.deliver
		end
		local ok = pcall(function() channel.ShouldDeliverCallback = callback end)
		if ok then
			bound[channel] = true
			channel:SetAttribute("StarlightNeuralBound", sessionId)
		else
			issue("A chat channel could not be bound; check for another chat delivery script.")
		end
	end

	local function command(player, text)
		if not isAdmin(player) or type(text) ~= "string" or #text > CONFIG.MaxMessageBytes then return end
		local state = states[player.UserId] or addPlayer(player)
		if os.clock() - state.lastCommand < 0.5 then return end
		state.lastCommand = os.clock()
		local verb, argument = text:match("^/?sn%s+(%S+)%s*(.*)$")
		verb = verb and verb:lower()
		if verb == "status" then
			print(string.format("[Starlight Neural] %s | enabled=%s | messages=%d | analysed=%d | blocked=%d | queued=%d | mean=%.3fms | peak=%.3fms", Engine.version, tostring(CONFIG.Enabled), metrics.messages, metrics.analyses, metrics.blocked, pendingCount, metrics.totalAnalysisTime / math.max(1, metrics.analyses) * 1000, metrics.maxAnalysisTime * 1000))
		elseif verb == "test" then
			local result = Engine.analyze(argument ~= "" and argument or "hello")
			print(string.format("[Starlight Neural] %s | confidence=%.3f | risk=%.3f | corroborated=%s | support=%s", result.category, result.confidence, result.risk, tostring(result.corroborated), tostring(result.support)))
		elseif verb == "audit" then
			for index = math.max(1, #audit - 9), #audit do
				local entry = audit[index]
				print(string.format("[Starlight Neural] %d | %d | %s | %s", entry.timestamp, entry.userId, entry.category, entry.action))
			end
		elseif verb == "enable" then CONFIG.Enabled = true
		elseif verb == "disable" then CONFIG.Enabled = false
		elseif verb == "diagnostic" then CONFIG.Debug = not CONFIG.Debug
		elseif verb == "unmute" or verb == "mute" then
			local id = tonumber(argument:match("^(%d+)$"))
			local target = id and states[id]
			if target then
				if verb == "unmute" then target.strikes = {}; target.seriousStrikes = {}; target.risk = 0 end
				setMute(target, verb == "mute" and CONFIG.MuteDuration or 0)
				print("[Starlight Neural] " .. verb .. " " .. tostring(id))
			end
		end
	end

	local function tick()
		local now = os.clock()
		pruneCache(cache, now)
		pruneCache(semanticCache, now)
		for _, state in states do
			if not state.loaded and not state.loading and state.nextLoad <= now then loadState(state) end
			if state.muteUntil > 0 and state.muteUntil <= os.time() then
				state.player:SetAttribute("StarlightMutedUntil", 0)
			end
			while state.history[1] and now - state.history[1].time > CONFIG.ContextLifetime do table.remove(state.history, 1) end
			if state.dirty then enqueue(state) end
		end
		if now >= nextSave then
			nextSave = now + CONFIG.PersistenceInterval
			flush()
		elseif closing or draining then flush()
		else
			for _, item in pending do
				if item.attempts > 0 and item.nextAttempt <= now and not item.inFlight then flush(); break end
			end
		end
	end

	local function shutdown()
		if closing then return end
		closing = true
		for _, state in states do if state.dirty then enqueue(state) end end
		local deadline = os.clock() + CONFIG.ShutdownTimeout
		while pendingCount > 0 and os.clock() < deadline do
			flush()
			task.wait(0.1)
		end
		if pendingCount > 0 then warn("[Starlight Neural] Shutdown ended with " .. tostring(pendingCount) .. " unsaved records.") end
		active = false
		for _, connection in connections do connection:Disconnect() end
	end

	api.process, api.addPlayer, api.removePlayer = process, addPlayer, removePlayer
	api.tick, api.flush, api.shutdown, api.command = tick, flush, shutdown, command
	api.states, api.cache, api.pending, api.audit, api.metrics = states, cache, pending, audit, metrics
	api.semanticCache = semanticCache

	connections[#connections + 1] = Players.PlayerAdded:Connect(addPlayer)
	connections[#connections + 1] = Players.PlayerRemoving:Connect(removePlayer)
	for _, player in Players:GetPlayers() do addPlayer(player) end
	connections[#connections + 1] = TextChatService.DescendantAdded:Connect(bindChannel)
	for _, channel in TextChatService:GetDescendants() do bindChannel(channel) end

	local chatCommand = Instance.new("TextChatCommand")
	chatCommand.Name = "StarlightNeuralCommand"
	chatCommand.PrimaryAlias = "/sn"
	connections[#connections + 1] = chatCommand.Triggered:Connect(function(source, text)
		local player = source and Players:GetPlayerByUserId(source.UserId)
		if player then command(player, text) end
	end)
	chatCommand.Parent = TextChatService

	game:BindToClose(shutdown)
	task.spawn(function()
		while active and not closing do
			task.wait(CONFIG.MaintenanceInterval)
			if active and not closing then tick() end
		end
	end)
	print("[Starlight Neural] Ready | " .. Engine.version)
	return api
end)()
