local function wordsOf(text, limit)
    local words = {}
    local last = 0
    for position, word in text:gmatch("()([%w]+)") do
        if #words == limit then
            return words, last, true
        end
        words[#words + 1] = word
        last = position + #word - 1
    end
    return words, last, false
end

local function normalize(text)
    if type(text) ~= "string" or #text > 2048 then
        return nil
    end
    local valid, length = pcall(utf8.len, text)
    if not valid or not length then
        return nil
    end
    local pieces = {}
    local changed = false
    local count = 0
    for _, point in utf8.codes(text) do
        count += 1
        if count > 500 then
            break
        end
        if Invisible[point] then
            changed = true
        elseif point >= 0xFF01 and point <= 0xFF5E then
            pieces[#pieces + 1] = string.char(point - 0xFF01 + 0x21)
            changed = true
        elseif Confusables[point] then
            pieces[#pieces + 1] = Confusables[point]
            if point < 0x2018 or point > 0x201D then
                changed = true
            end
        elseif point < 32 then
            pieces[#pieces + 1] = point == 10 and ";" or " "
        else
            pieces[#pieces + 1] = utf8.char(point)
        end
    end
    local cleaned = string.lower(table.concat(pieces)):gsub("(%w)'(%w)", "%1%2")
    for _, entry in ipairs(Separated) do
        local replacements
        cleaned, replacements = cleaned:gsub(entry[1], entry[2])
        changed = changed or replacements > 0
    end
    cleaned = cleaned:gsub("[%w@$]+", function(word)
        local candidate = word
        if word:find("%a") and #word > 2 then
            candidate = word:gsub("[013457@$]", Leet)
        end
        local compact = candidate:find("(.)%1") and compactRuns(candidate) or candidate
