local function hash(text)
    local value = 5381
    for index = 1, #text do
        value = (value * 33 + string.byte(text, index)) % 256
    end
    return value + 1
end

local function infer(words)
    local features = {}
    local active = {}
    local function add(key, amount)
        local index = hash(key)
        if not features[index] then
            active[#active + 1] = index
        end
        features[index] = math.min(2, (features[index] or 0) + amount)
    end
    for index, word in ipairs(words) do
        add("u:" .. word, 1)
        if index > 1 then
            add("b:" .. words[index - 1] .. " " .. word, 0.7)
        end
    end
    local norm = 0
    for _, index in ipairs(active) do
        norm += features[index] * features[index]
    end
    norm = math.max(math.sqrt(norm), 1e-9)
    local hidden = {}
    for column = 1, 16 do
        hidden[column] = HiddenBias[column]
    end
    for _, index in ipairs(active) do
        local value = features[index] / norm
        local row = InputWeights[index]
        for column = 1, 16 do
            hidden[column] += value * row[column]
        end
    end
    local logits = {}
    local maximum = -math.huge
    for output = 1, #ModelLabels do
        local value = OutputBias[output]
        for column = 1, 16 do
            value += math.max(hidden[column], 0) * OutputWeights[column][output]
        end
        logits[output] = value
        maximum = math.max(maximum, value)
    end
    local denominator = 0
    for index, value in ipairs(logits) do
        logits[index] = math.exp(value - maximum)
        denominator += logits[index]
    end
    local scores = {}
    local label, confidence = "benign", 0
    for index, value in ipairs(logits) do
        local probability = value / denominator
        scores[ModelLabels[index]] = probability
        if probability > confidence then
            label, confidence = ModelLabels[index], probability
        end
    end
    return scores, label, confidence
end

local function phrases(text)
    local result = {byFirst={}}
    for phrase in text:gmatch("[^|]+") do
        local words = wordsOf(phrase, 96)
        result[#result + 1] = words
        local candidates = result.byFirst[words[1]]
        if not candidates then
            candidates = {}
            result.byFirst[words[1]] = candidates
        end
        candidates[#candidates + 1] = words
    end
    return result
end

local function matchAt(words, phrase, start)
    if start < 1 or start + #phrase - 1 > #words then
        return false
    end
    for index, word in ipairs(phrase) do
        if words[start + index - 1] ~= word then
            return false
        end
    end
    return true
end

local function findPhrase(words, choices)
    for start = 1, #words do
        local candidates = choices.byFirst[words[start]]
        if candidates then
            for _, phrase in ipairs(candidates) do
                if matchAt(words, phrase, start) then
                    return start, start + #phrase - 1
                end
            end
        end
    end
    return nil
end

local Negation = wordSet("not never dont wont cannot cant avoid stop isnt arent wasnt werent")
local function negated(words, index, stopAtSubject)
    for before = index - 1, math.max(1, index - 6), -1 do
        local word = words[before]
        if word == "and" or word == "but" or word == "however" then
            break
        end
        if Negation[word] then
            return true
        end
        if stopAtSubject and (word == "i" or word == "im" or word == "ill") then
            break
        end
    end
    return false
end

local function findAction(words, choices)
    for start = 1, #words do
        local candidates = choices.byFirst[words[start]]
        if candidates then
            for _, phrase in ipairs(candidates) do
                if matchAt(words, phrase, start) and not negated(words, start) then
                    return start, start + #phrase - 1
                end
            end
        end
    end
    return nil
end

