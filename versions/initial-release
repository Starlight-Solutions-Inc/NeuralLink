local function compactRuns(word: string): string
    local pieces = {}
    local prior = ""
    for index = 1, #word do
        local letter = word:sub(index, index)
        if letter ~= prior then
            pieces[#pieces + 1] = letter
            prior = letter
        end
    end
    return table.concat(pieces)
end
